{
  "name": "storybook-rsbuild-monorepo",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "pnpm --filter \"./packages/*\" run build",
    "build:sandboxes": "pnpm --filter \"./sandboxes/*\" run build:storybook",
    "build:test": "cross-env SB_RSBUILD_TEST_MINIMAL_DEV=true pnpm build",
    "bump": "bumpp",
    "check": "rstack check",
    "check-dependency-version": "pnpm jiti ./scripts/check-dependency-version.mts",
    "dev": "pnpm --parallel --filter \"./packages/**\" run dev",
    "e2e": "pnpm exec playwright test --config e2e/playwright.config.ts",
    "format": "rstack fmt --no-cache",
    "lint": "rstack lint",
    "prepare": "rstack hooks",
    "test": "cross-env NODE_OPTIONS=--max_old_space_size=4096 rstack test",
    "test:watch": "cross-env NODE_OPTIONS=--max_old_space_size=4096 rstack test watch",
    "type-check": "pnpm --parallel --filter \"./packages/**\" run type-check"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@rstest/core": "~0.11.10",
    "@testing-library/jest-dom": "^6.9.1",
    "bumpp": "^10.4.1",
    "check-dependency-version-consistency": "^5.0.1",
    "cross-env": "^10.1.0",
    "get-port": "^7.2.0",
    "jiti": "^2.7.0",
    "path-serializer": "^0.6.0",
    "prettier-plugin-organize-imports": "^4.3.0",
    "rstack": "0.6.5",
    "storybook-rsbuild-scripts": "workspace:*",
    "tree-kill": "^1.2.2",
    "ts-dedent": "^2.3.0",
    "typescript": "^5.9.3"
  },
  "packageManager": "pnpm@10.14.0"
}
