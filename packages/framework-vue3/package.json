{
  "name": "storybook-vue3-rsbuild",
  "version": "3.6.1",
  "description": "Storybook for Vue3 and Rsbuild: Develop React Component in isolation with Hot Reloading.",
  "keywords": [
    "storybook",
    "rsbuild",
    "rspack",
    "vue3"
  ],
  "homepage": "https://storybook.rsbuild.rs",
  "bugs": {
    "url": "https://github.com/rstackjs/storybook-rsbuild/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/rstackjs/storybook-rsbuild",
    "directory": "packages/framework-vue3"
  },
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/node/index.d.ts",
      "default": "./dist/node/index.js"
    },
    "./package.json": "./package.json",
    "./preset": "./dist/preset.js"
  },
  "files": [
    "dist/**/*",
    "README.md",
    "*.js",
    "*.d.ts",
    "!src/**/*"
  ],
  "scripts": {
    "build": "rstack lib",
    "dev": "rstack lib --watch",
    "prepare": "pnpm run build"
  },
  "dependencies": {
    "@storybook/vue3": "^11.0.0-alpha.7",
    "storybook-builder-rsbuild": "workspace:*",
    "vue-docgen-api": "^4.79.2",
    "vue-docgen-loader": "^2.0.1"
  },
  "devDependencies": {
    "@microsoft/api-extractor": "^7.59.4",
    "@rsbuild/core": "^2.2.13",
    "@types/node": "^22.12.0",
    "storybook": "11.0.0-alpha.7",
    "typescript": "^5.9.3",
    "vue": "^3.5.44"
  },
  "peerDependencies": {
    "@rsbuild/core": "^1.5.0 || ^2.0.0-0",
    "storybook": "^11.0.0-alpha.7",
    "typescript": "^5.9.0 || ^6.0.0 || ^7.0.0",
    "vue": "^3.0.0"
  },
  "peerDependenciesMeta": {
    "typescript": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "bundler": {
    "entries": [
      "./src/node/index.ts",
      "./src/index.ts",
      "./src/preset.ts"
    ],
    "platform": "node"
  }
}
