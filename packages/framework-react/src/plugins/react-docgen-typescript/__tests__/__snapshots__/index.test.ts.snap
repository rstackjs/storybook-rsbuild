{
  "code": "import * as React from 'react'

interface DefaultPropValueComponentProps {
  /**
   * Button color.
   *
   * @default blue
   **/
  color: 'blue' | 'green'

  /**
   * Button counter.
   */
  counter: number

  /**
   * Button disabled.
   */
  disabled: boolean
}

