{
  "name": "storybook-react-native-web-rsbuild",
  "version": "3.6.1",
  "description": "Storybook for React Native Web and Rsbuild: Develop React Native components for web in isolation with Hot Reloading.",
  "keywords": [
    "storybook",
    "rsbuild",
    "rspack",
    "react-native",
    "react-native-web",
    "expo"
  ],
  "homepage": "https://storybook.rsbuild.rs",
  "bugs": {
    "url": "https://github.com/rstackjs/storybook-rsbuild/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/rstackjs/storybook-rsbuild",
    "directory": "packages/framework-react-native-web"
  },
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/node/index.d.ts",
      "default": "./dist/node/index.js"
    },
    "./package.json": "./package.json",
    "./preset": "./dist/preset.js"
  },
  "files": [
    "dist/**/*",
    "README.md",
    "*.js",
    "*.d.ts",
    "!src/**/*"
  ],
  "scripts": {
    "build": "rstack lib",
    "dev": "rstack lib --watch",
    "prepare": "pnpm run build"
  },
  "dependencies": {
    "@storybook/react": "^11.0.0-alpha.7",
    "rsbuild-plugin-react-native-web": "workspace:*",
    "storybook-builder-rsbuild": "workspace:*",
    "storybook-react-rsbuild": "workspace:*"
  },
  "devDependencies": {
    "@microsoft/api-extractor": "^7.59.4",
    "@rsbuild/core": "^2.2.13",
    "@types/node": "^22.12.0",
    "@types/react": "^18.3.31",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-native-web": "^0.21.4",
    "storybook": "11.0.0-alpha.7",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "@rsbuild/core": "^1.5.0 || ^2.0.0-0",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0",
    "react-native-web": "^0.19.0 || ^0.20.0 || ^0.21.0",
    "storybook": "^11.0.0-alpha.7",
    "typescript": ">= 5.9.x"
  },
  "peerDependenciesMeta": {
    "typescript": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "bundler": {
    "entries": [
      "./src/node/index.ts",
      "./src/index.ts",
      "./src/preset.ts"
    ],
    "platform": "node"
  }
}
