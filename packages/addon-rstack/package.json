{
  "name": "storybook-addon-rstack",
  "version": "4.0.0-beta.0",
  "description": "Storybook addon for loading configuration of Rstack CLI",
  "keywords": [
    "storybook",
    "storybook-addons",
    "rsbuild",
    "rspack",
    "rstack"
  ],
  "homepage": "https://storybook.rsbuild.rs",
  "bugs": {
    "url": "https://github.com/rstackjs/storybook-rsbuild/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/rstackjs/storybook-rsbuild",
    "directory": "packages/addon-rstack"
  },
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json",
    "./preset": "./dist/preset.js"
  },
  "files": [
    "dist/**/*",
    "README.md",
    "*.js",
    "*.d.ts",
    "!src/**/*"
  ],
  "scripts": {
    "build": "rs lib",
    "dev": "rs lib --watch",
    "prepare": "pnpm run build"
  },
  "devDependencies": {
    "@microsoft/api-extractor": "^7.59.4",
    "@rsbuild/core": "^2.2.13",
    "@types/node": "^22.12.0",
    "rstack": "0.9.0",
    "storybook": "11.0.0-beta.0",
    "storybook-addon-rslib": "workspace:*",
    "storybook-builder-rsbuild": "workspace:*",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "@rsbuild/core": "^2.0.0",
    "rstack": "^0.7.4",
    "storybook-builder-rsbuild": "workspace:^"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
