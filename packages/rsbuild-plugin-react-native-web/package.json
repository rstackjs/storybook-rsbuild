{
  "name": "rsbuild-plugin-react-native-web",
  "version": "4.0.0-beta.0",
  "description": "Rsbuild plugin for React Native Web support",
  "keywords": [
    "rsbuild",
    "rspack",
    "react-native",
    "react-native-web",
    "expo"
  ],
  "homepage": "https://github.com/rstackjs/storybook-rsbuild",
  "bugs": {
    "url": "https://github.com/rstackjs/storybook-rsbuild/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/rstackjs/storybook-rsbuild",
    "directory": "packages/rsbuild-plugin-react-native-web"
  },
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/**/*",
    "README.md",
    "*.js",
    "*.d.ts",
    "!src/**/*"
  ],
  "scripts": {
    "build": "rs lib",
    "dev": "rs lib --watch",
    "prepare": "pnpm run build"
  },
  "dependencies": {
    "magic-string": "^1.4.3",
    "pathe": "^2.0.3"
  },
  "devDependencies": {
    "@microsoft/api-extractor": "^7.59.4",
    "@rsbuild/core": "^2.2.13",
    "@types/node": "^22.12.0",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "@rsbuild/core": "^2.0.0"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "bundler": {
    "entries": [
      "./src/index.ts"
    ],
    "platform": "node"
  }
}
