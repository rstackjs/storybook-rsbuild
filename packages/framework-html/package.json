{
  "name": "storybook-html-rsbuild",
  "version": "3.6.1",
  "description": "Storybook for HTML and Rsbuild: View HTML snippets in isolation with Hot Reloading.",
  "keywords": [
    "storybook",
    "rsbuild",
    "rspack",
    "vanilla",
    "html"
  ],
  "homepage": "https://storybook.rsbuild.rs",
  "bugs": {
    "url": "https://github.com/rstackjs/storybook-rsbuild/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/rstackjs/storybook-rsbuild",
    "directory": "packages/framework-html"
  },
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/node/index.d.ts",
      "default": "./dist/node/index.js"
    },
    "./package.json": "./package.json",
    "./preset": "./dist/preset.js"
  },
  "files": [
    "dist/**/*",
    "README.md",
    "*.js",
    "*.d.ts",
    "!src/**/*"
  ],
  "scripts": {
    "build": "rstack lib",
    "dev": "rstack lib --watch",
    "prepare": "pnpm run build"
  },
  "dependencies": {
    "@storybook/html": "^11.0.0-alpha.8",
    "storybook-builder-rsbuild": "workspace:*"
  },
  "devDependencies": {
    "@microsoft/api-extractor": "^7.59.4",
    "@rsbuild/core": "^2.2.13",
    "@types/node": "^22.12.0",
    "storybook": "11.0.0-alpha.8",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "@rsbuild/core": "^1.5.0 || ^2.0.0-0",
    "storybook": "^11.0.0-alpha.8"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "bundler": {
    "entries": [
      "./src/node/index.ts",
      "./src/index.ts",
      "./src/preset.ts"
    ],
    "platform": "node"
  }
}
