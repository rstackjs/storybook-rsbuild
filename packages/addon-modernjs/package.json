{
  "name": "storybook-addon-modernjs",
  "version": "4.0.0-beta.0",
  "description": "Storybook addon for loading configuration of Modern.js",
  "keywords": [
    "storybook",
    "storybook-addons",
    "rsbuild",
    "rspack",
    "modernjs"
  ],
  "homepage": "https://storybook.rsbuild.rs",
  "bugs": {
    "url": "https://github.com/rstackjs/storybook-rsbuild/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/rstackjs/storybook-rsbuild",
    "directory": "packages/addon-modernjs"
  },
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json",
    "./preset": "./dist/preset.js"
  },
  "files": [
    "dist/**/*",
    "README.md",
    "*.js",
    "*.d.ts",
    "!src/**/*"
  ],
  "scripts": {
    "build": "rs lib",
    "dev": "rs lib --watch",
    "prepare": "pnpm run build"
  },
  "dependencies": {
    "find-up": "^5.0.0",
    "rslog": "1.3.2"
  },
  "devDependencies": {
    "@microsoft/api-extractor": "^7.59.4",
    "@modern-js/app-tools": "^3.10.0",
    "@modern-js/plugin": "^3.10.0",
    "@rsbuild/core": "^2.2.13",
    "@types/node": "^22.12.0",
    "storybook": "11.0.0-beta.1",
    "storybook-builder-rsbuild": "workspace:*",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "@modern-js/app-tools": "^3.0.0",
    "@modern-js/plugin": "^3.0.0",
    "@rsbuild/core": "^2.0.0",
    "storybook-builder-rsbuild": "workspace:^"
  },
  "peerDependenciesMeta": {
    "@modern-js/plugin": {
      "optional": true
    },
    "typescript": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "bundler": {
    "entries": [
      "./src/index.ts",
      "./src/preset.ts"
    ],
    "platform": "node"
  }
}
